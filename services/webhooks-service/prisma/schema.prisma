generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id          String     @id @db.Uuid
  url         String
  eventTypes  String[]   @map("event_types")
  secret      String
  status      String
  description String?
  createdAt   DateTime   @map("created_at") @db.Timestamptz(3)
  deliveries  Delivery[]

  @@map("subscriptions")
}

model Delivery {
  id             String            @id @db.Uuid
  subscriptionId String            @map("subscription_id") @db.Uuid
  eventId        String            @map("event_id") @db.Uuid
  eventName      String            @map("event_name")
  body           Json
  status         String
  attemptCount   Int               @map("attempt_count")
  nextAttemptAt  DateTime          @map("next_attempt_at") @db.Timestamptz(3)
  lastError      String?           @map("last_error")
  createdAt      DateTime          @map("created_at") @db.Timestamptz(3)
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id])
  attempts       DeliveryAttempt[]

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, id(sort: Desc)])
  @@map("deliveries")
}

model DeliveryAttempt {
  id         String   @id @db.Uuid
  deliveryId String   @map("delivery_id") @db.Uuid
  number     Int
  at         DateTime @db.Timestamptz(3)
  statusCode Int?     @map("status_code")
  error      String?
  durationMs Int      @map("duration_ms")
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, number])
  @@map("delivery_attempts")
}
