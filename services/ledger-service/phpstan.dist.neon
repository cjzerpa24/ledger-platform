parameters:
    level: 9
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    ignoreErrors:
        # Overrides a private KernelTrait method that the trait itself calls.
        -
            identifier: method.unused
            path: src/Kernel.php
        # The worker boots the test kernel, where App services are public
        # (PublicAppServicesForTestsPass); PHPStan only sees the dev container.
        -
            identifier: symfonyContainer.privateService
            path: tests/Concurrency/transfer_worker.php
